{
  "id": "home",
  "securityDomains": [
    "RequestEquipment"
  ],
  "include": [
    "bpRefs.script"
  ],
  "script": "<%
    /* The GraphQL criteria shape for plain TEXT fields is not covered by any Workday sample,
       so status narrowing happens here instead of in the query. See README, 'Filtering choices'. */
    const byStatus = function(rows, wanted) {
      if (empty(rows)) { return []; }
      return rows.filter(row => {row.status == wanted});
    };

    /* hrAccess reads an object only the HR Partner domain can see. A 403 there means 'not an HR partner',
       so that endpoint deliberately does not fail on 403 - see CONVENTIONS.md, deliberate deviations. */
    const isHrPartner = function() {
      if (empty(hrAccess)) { return false; }
      return hrAccess.data != null;
    };

    const myRows = function() {
      return empty(myRequests.data.myRequests.data) ? [] : myRequests.data.myRequests.data;
    };
  %>",
  "endPoints": [
    {
      "name": "me",
      "baseUrlType": "workday-graph",
      "httpMethod": "POST",
      "authType": "sso",
      "graphQuery": { "queryId": "me" },
      "failOnStatusCodes": [ { "code": 400 }, { "code": 403 } ]
    },
    {
      "name": "myRequests",
      "baseUrlType": "workday-graph",
      "httpMethod": "POST",
      "authType": "sso",
      "graphQuery": {
        "queryId": "myRequests",
        "parameters": {
          "requesterId": "<% me.data.worker.data[0].workdayID.id %>"
        }
      },
      "failOnStatusCodes": [ { "code": 400 }, { "code": 403 } ]
    }
,
    {
      "name": "hrAccess",
      "baseUrlType": "app",
      "url": "hrPartnerAccess?limit=1",
      "authType": "sso",
      "failOnStatusCodes": [ { "code": 400 } ]
    },
    {
      "name": "checkoutEvents",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "wqlQuery": {
        "queryId": "checkoutEvents",
        "parameters": {
          "applicationId": "<% site.applicationId %>"
        }
      },
      "failOnStatusCodes": [ { "code": 400 }, { "code": 403 } ]
    }
  ],
  "presentation": {
    "title": {
      "type": "title",
      "label": "<% presentationLabels.AppTitle %>"
    },
    "body": {
      "type": "section",
      "id": "homeBody",
      "children": [
        {
          "type": "section",
          "id": "homeColumns",
          "horizontal": true,
          "columnWidthRatios": [ 0.7, 0.3 ],
          "children": [
            {
              "type": "section",
              "id": "homeLoansSection",
              "title": "<% presentationLabels.OnLoanToYou %>",
              "children": [
                {
                  "type": "richText",
                  "id": "homeIntro",
                  "enabled": false,
                  "value": "<% presentationLabels.HomeIntro %>"
                },
                {
                  "type": "grid",
                  "gridType": "LIST",
                  "id": "activeLoans",
                  "rows": "<% byStatus(myRows(), 'APPROVED') %>",
                  "rowVariableName": "loan",
                  "enabled": false,
                  "doNotAdd": true,
                  "doNotRemove": true,
                  "label": "<% presentationLabels.ActiveLoans %>",
                  "emptyStateText": "<% presentationLabels.NoActiveLoans %>",
                  "columns": [
                    {
                      "type": "column",
                      "columnId": "loanItem",
                      "label": "<% presentationLabels.Item %>",
                      "cellTemplate": {
                        "type": "text",
                        "id": "loanItemCell",
                        "value": "<% loan.item.descriptor %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "loanDue",
                      "label": "<% presentationLabels.DueDate %>",
                      "sortableAndFilterable": true,
                      "cellTemplate": {
                        "type": "date",
                        "id": "loanDueCell",
                        "datePrecision": "DAY",
                        "dateFormat": "yyyy-MM-dd",
                        "value": "<% loan.dueDate %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "loanPurpose",
                      "label": "<% presentationLabels.Purpose %>",
                      "cellTemplate": {
                        "type": "text",
                        "id": "loanPurposeCell",
                        "value": "<% loan.purpose %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "loanActions",
                      "label": "<% presentationLabels.Actions %>",
                      "cellTemplate": {
                        "type": "button",
                        "id": "loanReturnButton",
                        "action": "LINK",
                        "label": "<% presentationLabels.StartReturn %>",
                        "taskReference": {
                          "taskId": "returnStart",
                          "parameterBindings": {
                            "requestId": "<% loan.workdayID.id %>"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "grid",
                  "gridType": "LIST",
                  "id": "pendingForMe",
                  "rows": "<% byStatus(myRows(), 'PENDING') %>",
                  "rowVariableName": "pending",
                  "enabled": false,
                  "doNotAdd": true,
                  "doNotRemove": true,
                  "label": "<% presentationLabels.AwaitingApproval %>",
                  "emptyStateText": "<% presentationLabels.NothingPending %>",
                  "columns": [
                    {
                      "type": "column",
                      "columnId": "pendingItem",
                      "label": "<% presentationLabels.Item %>",
                      "cellTemplate": {
                        "type": "text",
                        "id": "pendingItemCell",
                        "value": "<% pending.item.descriptor %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "pendingRequested",
                      "label": "<% presentationLabels.RequestedOn %>",
                      "cellTemplate": {
                        "type": "date",
                        "id": "pendingRequestedCell",
                        "datePrecision": "DAY",
                        "dateFormat": "yyyy-MM-dd",
                        "value": "<% pending.requestedOn %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "pendingApproval",
                      "label": "<% presentationLabels.ApprovalProcess %>",
                      "cellTemplate": {
                        "type": "instanceList",
                        "id": "pendingApprovalCell",
                        "enabled": false,
                        "render": "<% !empty(bpRefs.eventId(checkoutEvents, pending.workdayID.id)) %>",
                        "instanceList": [
                          {
                            "type": "instance",
                            "id": "<% bpRefs.eventId(checkoutEvents, pending.workdayID.id) %>",
                            "descriptor": "<% bpRefs.eventText(checkoutEvents, pending.workdayID.id, presentationLabels.ApprovalProcess) %>",
                            "wid": "<% bpRefs.eventId(checkoutEvents, pending.workdayID.id) %>"
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "section",
              "id": "homeCardsSection",
              "children": [
                {
                  "type": "cardContainer",
                  "layout": "MASONRY",
                  "cards": [
                    {
                      "type": "card",
                      "cardId": "AppLinks",
                      "parameters": "<% {'title': presentationLabels.KeyTasks, 'Browse': presentationLabels.BrowseCatalog, 'MyRequests': presentationLabels.MyRequests} %>"
                    }
                  ]
                },
                {
                  "type": "section",
                  "id": "hrPartnerSection",
                  "title": "<% presentationLabels.HrPartnerTools %>",
                  "render": "<% isHrPartner() %>",
                  "children": [
                    {
                      "type": "button",
                      "id": "hrRequestsButton",
                      "action": "LINK",
                      "label": "<% presentationLabels.HrRequestsTitle %>",
                      "taskReference": { "taskId": "hrRequests" }
                    },
                    {
                      "type": "button",
                      "id": "manageRequestsButton",
                      "action": "LINK",
                      "label": "<% presentationLabels.ManageRequests %>",
                      "taskReference": { "taskId": "manage" }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "richText",
          "id": "homeFooterText",
          "enabled": false,
          "value": "<% presentationLabels.PoweredBy %>"
        }
      ]
    }
  }
}
