{
  "id": "currentItem",
  "parameters": ["itemId"],
  "query": "query currentItem($itemId: ID!) { currentItem: equipmentcheckout_kmccyv_EquipmentItem(dataSource: {equipmentcheckout_kmccyv_equipmentItems: {}} where: {workdayID: {in: [{id: $itemId}]}}) { data { workdayID { id } descriptor assetTag itemName category serialNumber status notes displayLabel location { workdayID { id } descriptor } currentHolder { workdayID { id } descriptor } eligibleFromLevel eligibleLocation { workdayID { id } descriptor } } } }",
  "variables": {
    "itemId": "<% itemId %>"
  }
}
